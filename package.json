{
  "name": "interval-01",
  "version": "1.2.0",
  "private": true,
  "description": "A self-contained interval ear training studio with procedural Web Audio instruments.",
  "scripts": {
    "build": "python3 scripts/build.py",
    "test": "node --test tests/theory.test.cjs",
    "test:audio": "node tests/audio.cjs",
    "test:browser": "node tests/browser.cjs",
    "serve": "python3 -m http.server 4173 --bind 127.0.0.1",
    "test:mobile": "node tests/mobile-audio.cjs && node tests/mobile-sequence.cjs",
    "test:connections": "node tests/disjoint.cjs"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  },
  "engines": {
    "node": ">=20"
  }
}
